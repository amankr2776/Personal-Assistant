# JARVIS AI Assistant - Environment Variables
# Copy this to .env and fill in your keys

# --- AI Providers (server-side only, set in Vercel) ---
GEMINI_API_KEY=         # Google Gemini API key (free: https://aistudio.google.com/apikey)
GROQ_API_KEY=           # Groq API key (free: https://console.groq.com)

# --- Firebase (required for multi-user auth + per-user data) ---
# Create project at https://console.firebase.google.com
# Enable: Authentication (Email/Password + Google) + Firestore
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000:web:000

# --- Vercel KV (for persistent rate limiting) ---
# Create at https://vercel.com/dashboard/storage
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Optional ---
VITE_BACKEND_URL=http://localhost:8000
VITE_OLLAMA_URL=http://localhost:11434
