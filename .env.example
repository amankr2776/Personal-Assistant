# JARVIS AI Assistant - Environment Variables
# Copy this to .env and fill in your keys

# --- AI Providers (server-side only, set in Vercel) ---
GEMINI_API_KEY=         # Google Gemini API key (free: https://aistudio.google.com/apikey)
GROQ_API_KEY=           # Groq API key (free: https://console.groq.com)

# --- Firebase (required for multi-user auth + per-user data) ---
# Create project at https://console.firebase.google.com
# Enable: Authentication (Email/Password + Google) + Firestore
VITE_FIREBASE_API_KEY=AIzaSyCTX7yc3H6wGqfSZKc-5fmBLT_ObQGWZfg
VITE_FIREBASE_AUTH_DOMAIN=studio-5920787368-5b5cb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=studio-5920787368-5b5cb
VITE_FIREBASE_STORAGE_BUCKET=studio-5920787368-5b5cb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=964876206782
VITE_FIREBASE_APP_ID=1:964876206782:web:3fa62ccc850decdd0114ef

# --- Vercel KV (for persistent rate limiting) ---
# Create at https://vercel.com/dashboard/storage
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Optional ---
VITE_BACKEND_URL=http://localhost:8000
VITE_OLLAMA_URL=http://localhost:11434
